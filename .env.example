# Copier ce fichier vers .env et l'adapter. Ne jamais versionner .env.

# Marque et adresse : aucune n'est écrite en dur dans le code
APP_NAME="Cauri Charts"
APP_URL=http://localhost:8000
APP_ENV=local
APP_DEBUG=true
APP_LOCALE=fr
APP_TIMEZONE=Africa/Lome
# Chaîne aléatoire longue (au moins 32 caractères)
APP_KEY=change-moi-par-une-longue-chaine-aleatoire
CONTACT_EMAIL=contact@example.com

# Base de données MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cauricharts
DB_USER=root
DB_PASS=

# Pays mis en avant sur l'accueil
PILOT_COUNTRY=TG

# Intégrations (laisser vide en local : le site tourne sur les données d'exemple)
# Facultatif : fichier de secrets hors du projet (ex. C:/Users/moi/.secrets/cauri-charts.env)
SECRETS_FILE=
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA=10000
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Recherches de clips YouTube par passage de bin/import-charts.php (100 unités de quota chacune)
YOUTUBE_SEARCH_PER_RUN=30
AUDIOMACK_CONSUMER_KEY=
AUDIOMACK_CONSUMER_SECRET=
# IA (classement automatique des artistes, rédaction des posts)
# Gratuit par défaut : clé Gemini sur https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Recherche Google intégrée : payante (quota nul sur l’offre gratuite)
GEMINI_GROUNDING=false
# Secours gratuit si Gemini est à court de quota (AI_PROVIDER=groq pour l’utiliser en premier) : clé sur https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=
# Chaîne Telegram : jeton du bot (@BotFather) et identifiant de la chaîne (manage.py telegram --chats)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_URL=
# Vidéos des posts (facultatif) : chemin de ffmpeg
FFMPEG_PATH=
# Dossier local où ranger les posts générés (vide sur le serveur)
SOCIAL_EXPORT_DIR=
# Option payante : AI_PROVIDER=claude + clé sur console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Mesure d'audience et publicité : chargées SEULEMENT après consentement (bandeau cookies).
# Laisser vide pour désactiver. Le bandeau n'apparaît que si au moins un outil est actif.
# Vérification de propriété : Google Search Console et Bing Webmaster Tools (contenu de la balise meta)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
GA_MEASUREMENT_ID=
META_PIXEL_ID=
# Clips YouTube sur les fiches titres (domaine youtube-nocookie, chargés au clic)
YOUTUBE_EMBEDS=true
# Identifiant d’une playlist Spotify affichée sur l’accueil (lecteur chargé au clic, sans clé API)
SPOTIFY_PLAYLIST_ID=

# Mentions légales (vides = "[à compléter]" sur le site). À remplir dès que la structure existe.
LEGAL_PUBLISHER=
LEGAL_STATUS=
LEGAL_REGISTRATION=
LEGAL_ADDRESS=
LEGAL_DIRECTOR=
PRIVACY_EMAIL=
# Hébergeur : coordonnées exactes à recopier depuis le site ou le contrat o2switch
HOST_NAME=o2switch
HOST_ADDRESS=
HOST_CONTACT=https://www.o2switch.fr

# Images de partage (PNG via GD). Chemins de polices TTF facultatifs :
# sans valeur, le site cherche des polices système connues, sinon il sert du SVG.
SHARE_FONT_SERIF=
SHARE_FONT_SANS=
