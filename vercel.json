{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": "",
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{django/**,public/assets/**,resources/fonts/**}",
      "excludeFiles": "{django/.venv/**,django/.pg/**,django/staticfiles/**,**/__pycache__/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/cron/nuit",
      "schedule": "0 1 * * *"
    }
  ]
}